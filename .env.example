SYMBOL=BTCUSDT
INTERVAL=1h
LIMIT=200
STRATEGY=sma

FAST_PERIOD=10
SLOW_PERIOD=30

STARTING_CASH=10000
FEE_RATE=0.001
POSITION_FRACTION=1.0
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06

# === Obchodování (reálné / testnet / dry-run) ===
# dry-run = nic se neodesílá (výchozí, bezpečné)
# testnet = Binance Spot Testnet klíče
# live    = OSTRÉ peníze (vyžaduje ENABLE_LIVE_TRADING + LIVE_CONFIRM)
TRADING_MODE=dry-run
ENABLE_LIVE_TRADING=false
LIVE_CONFIRM=

BINANCE_API_KEY=
BINANCE_API_SECRET=
# Volitelně přepsat URL (např. https://api.binance.us nebo testnet)
# BINANCE_BASE_URL=https://api.binance.com

# Tvrdé limity (USDT)
MAX_ORDER_QUOTE=25
MAX_DAILY_QUOTE=100
MIN_ORDER_QUOTE=5
QUOTE_PER_BUY=15
